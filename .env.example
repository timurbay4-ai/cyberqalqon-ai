# ============================================================
# CyberQalqon AI — Environment Variables Template
# ============================================================
# COPY this file to .env and fill in real values locally.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=false

# --- Database ---
# Relative SQLite paths are resolved from the repository root.
DATABASE_URL=sqlite:///./backend/data/cyberqalqon.db
# One-shot approval gate. Keep false until a verified schema-17 backup and
# explicit operator approval exist; set true only for the approved schema-18 start.
ALLOW_M14_SCHEMA_MIGRATION=false

# --- Read-only Wazuh inventory API ---
# Keep credentials in ACL-restricted, Git-ignored files. The API integration stays
# UNAVAILABLE and agent states stay UNKNOWN unless both files and a trusted CA are set.
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USERNAME_FILE=
WAZUH_API_PASSWORD_FILE=
WAZUH_API_CA_BUNDLE=
WAZUH_API_TIMEOUT_SECONDS=3
WAZUH_API_MAX_RESPONSE_BYTES=2097152
WAZUH_API_PAGE_SIZE=500
WAZUH_API_MAX_PAGES=20
WAZUH_API_RETRY_ATTEMPTS=1
WAZUH_INVENTORY_CACHE_SECONDS=60
AGENT_HEALTH_HISTORY_MAX_RECORDS=10000

# --- One-shot operational health thresholds ---
OPERATIONAL_QUEUE_WARNING_DEPTH=100
OPERATIONAL_QUEUE_WARNING_BYTES=67108864
OPERATIONAL_OLDEST_PENDING_WARNING_SECONDS=60
OPERATIONAL_SHIPPER_LAG_WARNING_BYTES=8388608
OPERATIONAL_SOURCE_STALE_SECONDS=900

# --- Wazuh machine ingestion ---
WAZUH_INGEST_API_KEY=replace-with-a-long-random-ingestion-key
# Production Compose uses the mutually exclusive file form instead.
# WAZUH_INGEST_API_KEY_FILE=/run/secrets/wazuh_ingest_api_key
MAX_INGEST_BYTES=1048576

# --- Bounded SIEM security-event store ---
MAX_EVENT_INGEST_BYTES=262144
# M18 engineering feature gate. Keep false until a separately approved live canary.
EVENT_BATCH_INGEST_ENABLED=false
EVENT_BATCH_MAX_EVENTS=100
EVENT_BATCH_MAX_BYTES=2097152
EVENT_BATCH_PROCESSING_TIMEOUT_SECONDS=15
SECURITY_EVENT_RETENTION_DAYS=30
SECURITY_EVENT_MAX_RECORDS=100000

# --- Deterministic incident correlation (no background worker) ---
CORRELATION_ENABLED=true
CORRELATION_WINDOW_SECONDS=900
CORRELATION_MAX_CANDIDATES=200
CORRELATION_MAX_LINKS=50
CORRELATION_RETRY_ATTEMPTS=1

# --- Standalone Wazuh sender (normally installed from wazuh/configs/) ---
# The sender and backend may run on different hosts. Keep their env files separate in production.
CYBERQALQON_URL=https://cyberqalqon.example
CYBERQALQON_INGEST_API_KEY=replace-with-the-same-long-random-ingestion-key
CYBERQALQON_SENDER_DB=/var/lib/cyberqalqon-sender/sender.db
CYBERQALQON_CONNECT_TIMEOUT_SECONDS=5
CYBERQALQON_REQUEST_TIMEOUT_SECONDS=15
CYBERQALQON_MAX_ATTEMPTS=8
CYBERQALQON_BACKOFF_BASE_SECONDS=2
CYBERQALQON_BACKOFF_MAX_SECONDS=300
CYBERQALQON_QUEUE_MAX_ITEMS=10000
CYBERQALQON_QUEUE_MAX_BYTES=536870912
CYBERQALQON_DEAD_LETTER_MAX_ITEMS=1000
# M18 event-shipper batch protocol. This remains independent from the local
# archive-read batch and must stay false until backend compatibility is verified.
CYBERQALQON_EVENT_BATCH_PROTOCOL_ENABLED=false
CYBERQALQON_EVENT_NETWORK_BATCH_SIZE=25
CYBERQALQON_EVENT_BATCH_MAX_BYTES=2097152
CYBERQALQON_EVENT_ADAPTIVE_ENABLED=false
CYBERQALQON_EVENT_ADAPTIVE_MIN_BATCH=10
CYBERQALQON_EVENT_ADAPTIVE_MAX_BATCH=25
CYBERQALQON_EVENT_ADAPTIVE_LOW_LATENCY_MS=150
CYBERQALQON_EVENT_ADAPTIVE_HIGH_LATENCY_MS=750

# --- Local Ollama AI analyst (disabled safely by default) ---
AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Required when AI_ENABLED=true. Models are installed by the operator, never at startup.
OLLAMA_MODEL=
# Keep false for loopback-only. When true, RFC1918/private IP literals, .local names,
# and only exact DNS names in OLLAMA_ALLOWED_HOSTS are accepted.
OLLAMA_ALLOW_PRIVATE_NETWORK=false
OLLAMA_ALLOWED_HOSTS=
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_CONTEXT_BYTES=32768
AI_MAX_ALERTS_PER_REQUEST=20
AI_MAX_NOTES_PER_REQUEST=20
AI_MAX_HISTORY_PER_REQUEST=40
AI_MAX_FIELD_CHARS=4096
AI_MAX_RAW_EVENT_CHARS=8192
AI_MAX_OUTPUT_CHARS=16384
AI_MAX_CONCURRENT_REQUESTS=1
AI_USER_COOLDOWN_SECONDS=2
AI_HEALTH_CACHE_SECONDS=15

# --- Human analyst sessions ---
# Secure must be true behind production HTTPS. Development HTTP requires false.
ANALYST_SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# --- Browser origin policy ---
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:3000
