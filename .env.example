# ============================================================
# CyberQalqon AI — Environment Variables Template
# ============================================================
# COPY this file to .env and fill in real values locally.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database (future) ---
DATABASE_URL=postgresql://user:password@localhost:5432/cyberqalqon

# --- Wazuh (future) ---
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=placeholder
WAZUH_API_PASSWORD=placeholder

# --- AI Engine (backend; local-only by default) ---
AI_PROVIDER=noop
AI_MODEL=
AI_BASE_URL=http://127.0.0.1:11434
AI_TIMEOUT_SECONDS=120
AI_MAX_INPUT_CHARS=16000
AI_MAX_CONCURRENT_REQUESTS=1
AI_TEMPERATURE=0.1

# --- Security ---
SECRET_KEY=replace-with-a-strong-random-secret
CORS_ORIGINS=http://localhost:3000
