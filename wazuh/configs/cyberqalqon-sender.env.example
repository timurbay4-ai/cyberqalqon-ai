# Install as /etc/cyberqalqon/sender.env with mode 0640, owner root:wazuh.
# Replace every placeholder locally. Never commit the installed file.

CYBERQALQON_URL=https://cyberqalqon.example
CYBERQALQON_INGEST_API_KEY=replace-with-the-backend-machine-ingestion-key
CYBERQALQON_SENDER_DB=/var/lib/cyberqalqon-sender/sender.db

CYBERQALQON_CONNECT_TIMEOUT_SECONDS=5
CYBERQALQON_REQUEST_TIMEOUT_SECONDS=15
CYBERQALQON_MAX_ATTEMPTS=8
CYBERQALQON_BACKOFF_BASE_SECONDS=2
CYBERQALQON_BACKOFF_MAX_SECONDS=300
CYBERQALQON_BACKOFF_JITTER_RATIO=0.20

CYBERQALQON_MAX_PAYLOAD_BYTES=1048576
CYBERQALQON_QUEUE_MAX_ITEMS=10000
CYBERQALQON_QUEUE_MAX_BYTES=536870912
CYBERQALQON_DEAD_LETTER_MAX_ITEMS=1000
CYBERQALQON_DEAD_LETTER_MAX_BYTES=134217728

CYBERQALQON_LEASE_SECONDS=60
CYBERQALQON_WORKER_BATCH_SIZE=100
CYBERQALQON_WORKER_POLL_SECONDS=5
CYBERQALQON_SQLITE_BUSY_TIMEOUT_SECONDS=5
CYBERQALQON_LOG_LEVEL=INFO

# M18 event-shipper protocol is disabled by default. Enabling it requires the
# separately approved backend batch feature gate and a controlled canary.
CYBERQALQON_EVENT_BATCH_PROTOCOL_ENABLED=false
CYBERQALQON_EVENT_NETWORK_BATCH_SIZE=25
CYBERQALQON_EVENT_BATCH_MAX_BYTES=2097152
CYBERQALQON_EVENT_ADAPTIVE_ENABLED=false
CYBERQALQON_EVENT_ADAPTIVE_MIN_BATCH=10
CYBERQALQON_EVENT_ADAPTIVE_MAX_BATCH=25
CYBERQALQON_EVENT_ADAPTIVE_LOW_LATENCY_MS=150
CYBERQALQON_EVENT_ADAPTIVE_HIGH_LATENCY_MS=750

# Optional private CA trust anchor. TLS verification always remains enabled.
# CYBERQALQON_CA_BUNDLE=/etc/cyberqalqon/internal-ca.pem

# Development only: plain HTTP is rejected unless the host is loopback and this is true.
CYBERQALQON_ALLOW_INSECURE_HTTP=false
