# M22 forward runtime has no credentials. It reuses the protected sender.env
# API key and backend origin. Copy only after explicit live approval.
CYBERQALQON_FORWARD_STATE=/var/lib/cyberqalqon-forward/m22-forward/REPLACE_WITH_GENERATION_ID.json

# This is a local read-loop limit; delivery remains one HTTP request per event.
CYBERQALQON_FORWARD_READ_LIMIT=10
CYBERQALQON_FORWARD_RECORDS_PER_SECOND=5
CYBERQALQON_FORWARD_POLL_SECONDS=5

# These production gates must remain disabled for M22.
CYBERQALQON_EVENT_BATCH_PROTOCOL_ENABLED=false
CYBERQALQON_EVENT_ADAPTIVE_ENABLED=false
AI_ENABLED=false
