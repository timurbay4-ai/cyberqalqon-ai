table inet cyberqalqon_lab {
    chain input {
        type filter hook input priority filter; policy accept;

        iifname "lo" ip saddr 127.0.0.1 tcp flags & (fin | syn | rst | ack) == syn ct state new \
            tcp dport { 22, 23, 25, 53, 80, 110, 143, 443, 445, 3306, 5432, 6379, 8000, 8080, 8443 } \
            limit rate 12/second burst 24 packets \
            log prefix "CQ-NETSCAN " level info
    }
}
