# ----- Secrets & Credentials (NEVER COMMIT) -----
.env
.env.*
!.env.example
!.env.production.example
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
secrets/
credentials/
backups/

# ----- Logs -----
*.log
*.log.*
logs/

# ----- Local Databases -----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
htmlcov/
.coverage
.coverage.*
coverage/
coverage.xml
*.cover

# ----- Node / Frontend -----
node_modules/
.npm
.yarn/
yarn-error.log
dist/
build/
.next/
.nuxt/
out/

# ----- IDE / Editor -----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Docker -----
*.env.docker

# ----- OS -----
Desktop.ini
ehthumbs.db

# ----- Testing / Coverage -----
.hypothesis/
junit.xml
test-results/

# ----- Temporary -----
*.tmp
*.bak
*.orig
