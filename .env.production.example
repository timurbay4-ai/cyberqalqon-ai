# Copy to an untracked .env.production, protect it with mode 0600, and replace
# every deployment-specific placeholder before rendering Compose configuration.

CYBERQALQON_ORIGIN=https://soc.example.invalid
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# These files are mounted at runtime. Never place their contents in this env file.
WAZUH_INGEST_API_KEY_FILE=./secrets/wazuh-ingest-api-key
TLS_CERT_PATH=./secrets/tls.crt
TLS_KEY_PATH=./secrets/tls.key
BACKUP_DIR=./backups
# Explicit one-shot approval gate for the prepared M14 schema-18 migration.
ALLOW_M14_SCHEMA_MIGRATION=false

# Read-only Wazuh inventory. Keep both credential files and the CA outside Git.
# Connectivity must remain loopback HTTPS unless an approved trusted path is used.
WAZUH_API_URL=https://127.0.0.1:55000
# For Compose, enable these only in a reviewed override that mounts the three
# host files read-only at the exact container paths. Empty values fail closed.
# WAZUH_API_USERNAME_FILE=/run/secrets/wazuh-api-reader.username
# WAZUH_API_PASSWORD_FILE=/run/secrets/wazuh-api-reader.password
# WAZUH_API_CA_BUNDLE=/run/secrets/wazuh-api-ca.pem
WAZUH_API_TIMEOUT_SECONDS=3
WAZUH_API_MAX_RESPONSE_BYTES=2097152
WAZUH_API_PAGE_SIZE=500
WAZUH_API_MAX_PAGES=20
WAZUH_API_RETRY_ATTEMPTS=1
WAZUH_INVENTORY_CACHE_SECONDS=60
AGENT_HEALTH_HISTORY_MAX_RECORDS=10000

OPERATIONAL_QUEUE_WARNING_DEPTH=100
OPERATIONAL_QUEUE_WARNING_BYTES=67108864
OPERATIONAL_OLDEST_PENDING_WARNING_SECONDS=60
OPERATIONAL_SHIPPER_LAG_WARNING_BYTES=8388608
OPERATIONAL_SOURCE_STALE_SECONDS=900

ANALYST_SESSION_TTL_SECONDS=28800
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# AI is fail-closed and disabled until an operator selects and installs a model.
AI_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=
OLLAMA_ALLOW_PRIVATE_NETWORK=true
OLLAMA_ALLOWED_HOSTS=ollama
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_CONCURRENT_REQUESTS=1
AI_USER_COOLDOWN_SECONDS=2

BACKEND_IMAGE=cyberqalqon/backend:0.9.0
WEB_IMAGE=cyberqalqon/web:0.9.0
OLLAMA_IMAGE=ollama/ollama:0.34.0
APP_GIT_COMMIT=replace-with-reviewed-git-sha
APP_BUILD_TIMESTAMP=replace-with-utc-build-timestamp

CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=5
