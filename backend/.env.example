APP_ENV=development
DATABASE_URL=sqlite:///./cyberqalqon.db
SQLITE_BUSY_TIMEOUT_MS=5000
# Enable only after PRAGMA foreign_key_check passes and database adoption is approved.
SQLITE_FOREIGN_KEYS=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
MAX_REQUEST_BODY_BYTES=1048576
API_ACCESS_TOKEN=
WAZUH_INGEST_TOKEN=
