{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberqalqon.ai/schemas/normalized_alert.schema.json",
  "title": "NormalizedAlert",
  "description": "Shared contract for a normalized security alert produced by the Wazuh ingestion pipeline and consumed by the backend and AI engine.",
  "type": "object",
  "required": ["alert_id", "timestamp", "agent", "rule", "mitre"],
  "additionalProperties": false,
  "properties": {
    "alert_id": {
      "type": "string",
      "description": "Unique identifier for this alert.",
      "minLength": 1,
      "examples": ["alert-20260930-001"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the alert was generated."
    },
    "agent": {
      "type": "object",
      "description": "Wazuh agent that detected the event.",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Wazuh agent ID.",
          "examples": ["001"]
        },
        "name": {
          "type": "string",
          "description": "Hostname or label of the agent.",
          "examples": ["WIN-PC-01"]
        },
        "ip": {
          "anyOf": [
            {"type": "string", "format": "ipv4"},
            {"type": "string", "format": "ipv6"}
          ],
          "description": "IP address reported for the Wazuh agent. Optional."
        }
      }
    },
    "rule": {
      "type": "object",
      "description": "Security rule that triggered this alert.",
      "required": ["id", "level", "description"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Rule identifier.",
          "examples": ["100001"]
        },
        "level": {
          "type": "integer",
          "description": "Wazuh rule severity level (0–16).",
          "minimum": 0,
          "maximum": 16
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the rule.",
          "examples": ["Multiple authentication failures"]
        },
        "groups": {
          "type": "array",
          "description": "Wazuh rule groups.",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "mitre": {
      "type": "object",
      "description": "MITRE ATT&CK context for this alert.",
      "required": ["ids", "tactics", "techniques"],
      "additionalProperties": false,
      "properties": {
        "ids": {
          "type": "array",
          "description": "Upstream MITRE ATT&CK technique IDs. The array may be empty.",
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
          },
          "uniqueItems": true,
          "examples": [["T1110"], ["T1110", "T1078"]]
        },
        "tactics": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "techniques": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "source": {
      "type": "object",
      "description": "Source network information. Optional.",
      "additionalProperties": false,
      "properties": {
        "ip": {
          "anyOf": [
            {"type": "string", "format": "ipv4"},
            {"type": "string", "format": "ipv6"}
          ]
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "destination": {
      "type": "object",
      "description": "Destination network information. Optional.",
      "additionalProperties": false,
      "properties": {
        "ip": {
          "anyOf": [
            {"type": "string", "format": "ipv4"},
            {"type": "string", "format": "ipv6"}
          ]
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "user": {
      "type": "string",
      "description": "Username associated with the event. Optional.",
      "examples": ["jsmith"]
    },
    "location": {
      "type": "string",
      "description": "Wazuh event source location. Optional."
    },
    "decoder_name": {
      "type": "string",
      "description": "Wazuh decoder name. Optional."
    }
  }
}
