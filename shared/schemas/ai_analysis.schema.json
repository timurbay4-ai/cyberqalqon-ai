{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberqalqon.ai/schemas/ai_analysis.schema.json",
  "title": "CyberQalqon AI Advisory Result v1",
  "description": "Strict structured output contract for local, advisory-only SOC analysis. Strings are untrusted display data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "assessment",
    "key_evidence",
    "mitre_context",
    "timeline_summary",
    "hypotheses",
    "investigation_steps",
    "possible_false_positive_reasons",
    "recommended_actions",
    "containment_considerations",
    "uncertainties"
  ],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "assessment": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "key_evidence": { "$ref": "#/$defs/boundedList12" },
    "mitre_context": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["technique_id", "explanation", "basis"],
        "properties": {
          "technique_id": { "type": "string", "minLength": 1, "maxLength": 32 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "basis": { "type": "string", "enum": ["observed", "inferred"] }
        }
      }
    },
    "timeline_summary": {
      "anyOf": [
        { "type": "string", "minLength": 1, "maxLength": 2400 },
        { "type": "null" }
      ]
    },
    "hypotheses": { "$ref": "#/$defs/boundedList10" },
    "investigation_steps": { "$ref": "#/$defs/boundedList12" },
    "possible_false_positive_reasons": { "$ref": "#/$defs/boundedList10" },
    "recommended_actions": { "$ref": "#/$defs/boundedList12" },
    "containment_considerations": { "$ref": "#/$defs/boundedList10" },
    "uncertainties": { "$ref": "#/$defs/boundedList10" }
  },
  "$defs": {
    "boundedText": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "boundedList10": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/boundedText" }
    },
    "boundedList12": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/boundedText" }
    }
  }
}
